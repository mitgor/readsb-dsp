index 0000000..3253ad8
--- /dev/null
+++ b/contrib/dsp-rescue/dsp_rescue/__main__.py
@@ -0,0 +1,101 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+import argparse, hashlib, json, re, sys, time
+from collections import Counter
+from pathlib import Path
+from .decode import Decoder, METHODS
+from .compare import evaluate
+
+
+def sha256(path):
+    h = hashlib.sha256()
+    with path.open("rb") as f:
+        for block in iter(lambda: f.read(1048576), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def main():
+    p = argparse.ArgumentParser(
+        description="Experimental DSP-only UC8 replay; never opens SDRs or feeder sockets."
+    )
+    p.add_argument("iq", type=Path, help="Interleaved unsigned I/Q at exactly 2.4 MS/s")
+    p.add_argument(
+        "--stock",
+        type=Path,
+        help="Paired normalized JSON event list, or timestamped @...; readsb text",
+    )
+    p.add_argument(
+        "--stock-offset-us",
+        type=float,
+        help="Subtract this from stock seconds; required for timestamped text",
+    )
+    p.add_argument("--methods", nargs="+", choices=METHODS, default=METHODS)
+    p.add_argument(
+        "--budget",
+        type=int,
+        default=32,
+        help="Maximum failed energy windows retried per 50 ms (1..128)",
+    )
+    p.add_argument("--threshold", type=float, default=0.4)
+    p.add_argument("--output", type=Path, required=True)
+    p.add_argument(
+        "--events", type=Path, help="Optional raw candidate JSON output, not a feed"
+    )
+    a = p.parse_args()
+    if a.output.resolve() == a.iq.resolve() or (
+        a.stock and a.output.resolve() == a.stock.resolve()
+    ):
+        p.error("Output must not overwrite an input")
+    if a.events and a.events.resolve() in {
+        a.iq.resolve(),
+        a.output.resolve(),
+        *([] if a.stock is None else [a.stock.resolve()]),
+    }:
+        p.error("Events path must differ from inputs and report")
+    events, work = Decoder(a.methods, a.budget, a.threshold).decode(a.iq)
+    duration = a.iq.stat().st_size / 4800000
+    report = dict(
+        scope="offline DSP-only replay",
+        iq_sha256=sha256(a.iq),
+        rf_seconds=duration,
+        real_time_factor=work["wall_s"] / duration,
+        raw_candidates=dict(Counter(r["source"] for r in events)),
+        work=work,
+        forwarding_enabled=False,
+    )
+    verified = True
+    if a.stock:
+        text = a.stock.read_text()
+        if text.lstrip().startswith("["):
+            stock = json.loads(text)
+        else:
+            if a.stock_offset_us is None:
+                p.error(
+                    "Timestamped text requires explicit --stock-offset-us and clock audit"
+                )
+            stock = [
+                dict(seconds=int(t, 16) / 12e6, message_hex=m.lower(), source="stock")
+                for t, m in re.findall(
+                    r"@([0-9a-fA-F]{12})([0-9a-fA-F]{14}(?:[0-9a-fA-F]{14})?);", text
+                )
+            ]
+        if a.stock_offset_us is not None:
+            stock = [
+                {**r, "seconds": r["seconds"] - a.stock_offset_us / 1e6} for r in stock
+            ]
+        result = evaluate(stock, events)
+        report["comparison"] = {
+            k: v for k, v in result.items() if k not in ("added", "merged")
+        }
+        report["stock_sha256"] = sha256(a.stock)
+        verified = result["alignment"]["verified"]
+    a.output.write_text(json.dumps(report, indent=2) + "\n")
+    if a.events:
+        a.events.write_text(json.dumps(events, indent=2) + "\n")
+    print(json.dumps(report, indent=2))
+    if not verified:
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/contrib/dsp-rescue/dsp_rescue/compare.py b/contrib/dsp-rescue/dsp_rescue/compare.py
new file mode 100644
index 0000000..fa34319
--- /dev/null
+++ b/contrib/dsp-rescue/dsp_rescue/compare.py
@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Paired replay audit. Guarded additions are candidates, not ground truth."""
+
+import bisect, math, statistics
+from collections import Counter, defaultdict
+from .decode import METHODS
+from .dsp import crc_batch
+import numpy as np
+
+
+def valid(payload):
+    try:
+        row = bytes.fromhex(payload)
+    except (TypeError, ValueError):
+        return False
+    return (
+        len(row) == 14
+        and row[0] >> 3 == 17
+        and not crc_batch(np.frombuffer(row, np.uint8)[None, :])[0]
+    )
+
+
+def evaluate(stock, events):
+    # Baseline records, including non-DF17 traffic, are copied unchanged.
+    primary = [dict(r) for r in stock]
+    payloads = defaultdict(list)
+    identities = defaultdict(list)
+    for r in primary:
+        if not math.isfinite(r["seconds"]):
+            raise ValueError("Nonfinite stock timestamp")
+        p = r["message_hex"]
+        if valid(p):
+            payloads[p].append(r["seconds"])
+            identities[p[2:8]].append((r["seconds"], p))
+    for rows in (*payloads.values(), *identities.values()):
+        rows.sort()
+    candidates = [
+        r
+        for r in events
+        if r.get("source") in METHODS
+        and valid(r.get("message_hex"))
+        and math.isfinite(r["seconds"])
+        and r["seconds"] >= 0
+    ]
+    errors = []
+    matched = set()
+    for r in candidates:
+        if r["source"] != "energy":
+            continue
+        times = payloads.get(r["message_hex"], ())
+        i = bisect.bisect_left(times, r["seconds"])
+        near = times[max(0, i - 1) : i + 1]
+        if near:
+            closest = min(near, key=lambda t: abs(t - r["seconds"]))
+            key = (r["message_hex"], closest)
+            if key not in matched and abs(closest - r["seconds"]) < 0.001:
+                errors.append(abs(closest - r["seconds"]))
+                matched.add(key)
+    median = statistics.median(errors) if errors else None
+    audit = dict(
+        matches=len(errors),
+        median_abs_error_us=None if median is None else median * 1e6,
+        verified=len(errors) >= 20 and median <= 2e-6,
+    )
+    counts = Counter()
+    extra = []
+    if audit["verified"]:
+        for r in sorted(
+            candidates, key=lambda r: (METHODS.index(r["source"]), r["seconds"])
+        ):
+            p = r["message_hex"]
+            t = r["seconds"]
+            times = payloads.get(p, [])
+            i = bisect.bisect_left(times, t - 120e-6)
+            if i < len(times) and times[i] <= t + 120e-6:
+                counts["duplicate_120us"] += 1
+                continue
+            sightings = identities.get(p[2:8], ())
+            if not any(t - 30 <= s <= t for s, q in sightings):
+                counts["no_prior_stock_icao"] += 1
+                continue
+            if any(abs(s - t) <= 4e-6 and q != p for s, q in sightings):
+                counts["stock_conflict"] += 1
+                continue
+            extra.append(
+                {**r, "validation": "crc_and_prior_stock_icao", "provisional": True}
+            )
+            bisect.insort(payloads[p], t)
+            counts["added_" + r["source"]] += 1
+    else:
+        counts["alignment_unverified"] = len(candidates)
+    merged = sorted(
+        primary + extra, key=lambda r: (r["seconds"], r.get("source", "stock"))
+    )
+    return dict(
+        alignment=audit,
+        counts=dict(counts),
+        stock_records=len(primary),
+        stock_df17=sum(valid(r["message_hex"]) for r in primary),
+        added=extra,
+        merged=merged,
+    )
